generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Video {
  id           String        @id // YouTube video ID
  title        String
  channelId    String
  channelName  String
  views        Int
  likes        Int
  comments     Int
  duration     String
  publishedAt  DateTime
  thumbnailUrl String
  description  String        @default("")
  transcript   String?
  outlierScore Float?
  viewsPerHour Float?
  savedAt      DateTime      @default(now())
  folders      FolderVideo[]

  @@index([channelId])
}

model VideoAnalysis {
  id             Int      @id @default(autoincrement())
  videoIds       String
  analysisResult String
  inspirations   String
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model Channel {
  id           String   @id // YouTube channel ID
  name         String
  subscribers  Int
  totalViews   BigInt
  videoCount   Int
  averageViews Float?
  lastFetched  DateTime

  @@index([lastFetched])
}

/// A channel the user is planning, running, pausing or has archived.
/// Deliberately separate from `Channel`, which holds public YouTube channels
/// collected as research evidence and is shared across every workspace.
model ChannelWorkspace {
  id                    Int      @id @default(autoincrement())
  name                  String   @unique
  concept               String   @default("")
  status                String   @default("planned") // planned | active | paused | archived
  language              String   @default("en")
  country               String   @default("")
  targetAudience        String   @default("")
  contentFormat         String   @default("long-form")
  positioning           String   @default("")
  constraints           String   @default("")
  ownedYoutubeChannelId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  folders          Folder[]
  panels           Panel[]
  ideaGenerations  IdeaGeneration[]
  nicheDiscoveries NicheDiscovery[]
  outlierAnalyses OutlierAnalysis[]
  trackedChannels TrackedChannel[]
  collectionJobs  CollectionJob[]
  discoverySearches DiscoverySearch[]
  manualObservations ManualObservation[]
  referenceCollections ReferenceCollection[]
  researchJobs       ResearchJob[]
  ideas              Idea[]
  researchProfile    ChannelResearchProfile?
  queryPlans         QueryPlan[]

  @@index([status])
}

/// Creator-owned context used to plan searches. The core workspace fields
/// remain the canonical channel identity; this only holds additive notes.
model ChannelResearchProfile {
  id                Int      @id @default(autoincrement())
  workspaceId       Int      @unique
  planningNotes     String   @default("")
  updatedAt         DateTime @updatedAt
  workspace         ChannelWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// A reproducible planning artifact. Its rows are intentionally separate from
/// collection jobs, because approving a plan must never spend YouTube quota.
model QueryPlan {
  id            Int      @id @default(autoincrement())
  workspaceId   Int
  inputs        String
  provider      String   @default("none")
  model         String   @default("")
  promptVersion String   @default("query-plan-v1")
  manualPrompt  String   @default("")
  createdAt     DateTime @default(now())
  workspace     ChannelWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  queries       QueryPlanQuery[]

  @@index([workspaceId, createdAt])
}

model QueryPlanQuery {
  id               Int      @id @default(autoincrement())
  queryPlanId      Int
  position         Int
  query            String
  purpose          String
  mechanism        String   @default("")
  expectedEvidence String   @default("")
  sourceContext    String   @default("")
  language         String   @default("")
  region           String   @default("")
  generationReason String   @default("")
  selected         Boolean  @default(true)
  queryPlan        QueryPlan @relation(fields: [queryPlanId], references: [id], onDelete: Cascade)

  @@index([queryPlanId, position])
}


/// A user-requested research task. It is deliberately queued for Codex to
/// claim through the local CLI; the browser never claims to invoke Codex.
model ResearchJob {
  id          Int      @id @default(autoincrement())
  workspaceId Int
  schemaVersion String  @default("research-job-v1")
  status      String   @default("queued") // queued | claimed | researching | completed | failed
  intent      String
  input       String
  result      String?
  quotaBudget Int      @default(0)
  quotaUsed   Int      @default(0)
  error       String?
  claimedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   ChannelWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  evidence    ResearchJobEvidence[]
  ideas       Idea[]

  @@index([workspaceId, status, createdAt])
}

/// Sourced evidence supplied while a research job is worked. Source type makes
/// primary reporting distinguishable from commentary instead of trusting prose.
model ResearchJobEvidence {
  id          Int      @id @default(autoincrement())
  researchJobId Int
  url         String
  sourceType  String   // primary | commentary
  title       String   @default("")
  claim       String
  note        String   @default("")
  createdAt   DateTime @default(now())
  researchJob ResearchJob @relation(fields: [researchJobId], references: [id], onDelete: Cascade)

  @@index([researchJobId])
}

/// An editable original concept. Its job link explains where it came from;
/// evidenceLinks contains the specific saved videos, collections, or sources.
model Idea {
  id               Int      @id @default(autoincrement())
  workspaceId      Int
  researchJobId    Int?
  title            String
  audiencePromise  String   @default("")
  angle            String   @default("")
  evidenceLinks    String   @default("[]")
  risks            String   @default("")
  freshness        String   @default("")
  productionRequirements String @default("")
  confidence       String   @default("unknown") // low | medium | high | unknown
  status           String   @default("inbox") // inbox | shortlisted | researching | selected | rejected | produced | published
  rejectionReason  String   @default("")
  selectedPackage  String   @default("")
  rejectedPackages String   @default("[]")
  rank             Int      @default(0)
  researchBrief    String   @default("")
  /// Production notes per stage of the current-video workflow, as
  /// {"<stage>":{"notes":"…","done":true}}. Only the stages the user has
  /// touched are present; a missing stage means nothing has been written yet.
  production       String   @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  workspace        ChannelWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  researchJob      ResearchJob? @relation(fields: [researchJobId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, updatedAt])
}

/// Qualitative evidence deliberately written by the creator or Codex after a
/// visual review. It is never presented as an API fact or calculated metric.
model ManualObservation {
  id              Int      @id @default(autoincrement())
  workspaceId     Int
  entityType      String   // video | channel | topic
  entityId        String
  topic           String   @default("")
  viewerPromise   String   @default("")
  titleThumbnail  String   @default("")
  formatNotes     String   @default("")
  productionStyle String   @default("")
  notes           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  workspace       ChannelWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, entityType, entityId])
}

/// Global, local-only limits for public YouTube Data API collection. One row
/// (id = 1) is created on first use so the UI can make the budget explicit.
model QuotaPolicy {
  id                 Int      @id
  dailyBudget        Int      @default(1000)
  manualReserve      Int      @default(200)
  searchCacheHours   Int      @default(24)
  /// Snapshots older than this may be thinned to one per video per day.
  /// A video's first and last observation are never removed.
  snapshotThinAfterDays Int   @default(90)
  updatedAt          DateTime @updatedAt
  quotaEvents        QuotaEvent[]
}

/// Every public Data API request attempted by the collection engine.
model QuotaEvent {
  id            Int      @id @default(autoincrement())
  policyId      Int      @default(1)
  endpoint      String
  expectedCost  Int
  actualCost    Int?
  jobId         Int?
  detail        String   @default("")
  result        String
  error         String?
  createdAt     DateTime @default(now())
  policy        QuotaPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  job           CollectionJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([jobId])
}

model CollectionJob {
  id          Int      @id @default(autoincrement())
  workspaceId Int
  kind        String   // discovery | refresh
  status      String   @default("queued") // queued | running | completed | blocked | failed
  scope       String
  result      String?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  workspace   ChannelWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  quotaEvents QuotaEvent[]

  @@index([workspaceId, createdAt])
  @@index([status])
}

/// A workspace chooses which public channels deserve recurring collection.
model TrackedChannel {
  id               Int      @id @default(autoincrement())
  workspaceId      Int
  channelId        String
  priority         String   @default("tier-2") // tier-1 | tier-2 | tier-3
  refreshSchedule  String   @default("weekly") // daily | weekly | monthly | manual
  lastRefreshedAt  DateTime?
  createdAt        DateTime @default(now())
  workspace        ChannelWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  snapshots        ChannelSnapshot[]

  @@unique([workspaceId, channelId])
  @@index([workspaceId, priority])
}

model ChannelSnapshot {
  id               Int      @id @default(autoincrement())
  trackedChannelId Int
  channelId        String
  subscribers      Int?
  totalViews       BigInt?
  videoCount       Int?
  collectedAt      DateTime @default(now())
  trackedChannel   TrackedChannel @relation(fields: [trackedChannelId], references: [id], onDelete: Cascade)

  @@index([channelId, collectedAt])
}

model VideoSnapshot {
  id          Int      @id @default(autoincrement())
  videoId     String
  channelId   String
  views       Int?
  likes       Int?
  comments    Int?
  /// Copied from the upload at collection time so a snapshot's age can be
  /// calculated later without spending another videos.list call.
  publishedAt DateTime?
  collectedAt DateTime @default(now())

  @@index([videoId, collectedAt])
  @@index([channelId, collectedAt])
}

/// Cached discovery responses prevent identical `search.list` requests from
/// spending quota again during the configured cache period.
model DiscoverySearch {
  id          Int      @id @default(autoincrement())
  workspaceId Int
  queryKey    String
  query       String
  region      String   @default("")
  language    String   @default("")
  scope       String
  result      String
  collectedAt DateTime @default(now())
  expiresAt   DateTime
  workspace   ChannelWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, queryKey])
  @@index([expiresAt])
}

/// A reproducible outlier result saved by a user in a channel workspace. This is
/// an analysis record, not a time-series statistic snapshot (Stage 3 owns those).
model OutlierAnalysis {
  id                   Int              @id @default(autoincrement())
  workspaceId          Int
  videoId              String
  metric               String
  formulaVersion       String
  sampleSize           Int
  comparisonWindowDays Int
  format               String
  collectedAt          DateTime
  result               String
  createdAt            DateTime         @default(now())
  workspace            ChannelWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, collectedAt])
  @@index([videoId])
}

/// A deliberate set of reference videos gathered across several searches for one
/// research question. Separate from `Folder`, which holds saved `Video` rows for
/// idea generation: a reference is evidence about packaging, kept with the scope
/// it was found under so a Spanish result is never re-read as an English one.
model ReferenceCollection {
  id          Int      @id @default(autoincrement())
  workspaceId Int
  name        String
  question    String   @default("")
  createdAt   DateTime @default(now())
  workspace   ChannelWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items       ReferenceItem[]

  @@unique([workspaceId, name])
}

model ReferenceItem {
  id           Int      @id @default(autoincrement())
  collectionId Int
  videoId      String
  title        String
  channelId    String
  channelName  String
  thumbnailUrl String
  /// `null` when YouTube withheld the view count at collection time.
  views        Int?
  publishedAt  DateTime
  format       String
  /// The scope the result was found under, kept per item because one job may
  /// run Spanish and English queries across different niches.
  language     String   @default("")
  region       String   @default("")
  sourceQuery  String   @default("")
  /// Why this reference was kept: topic | title | thumbnail | hook | structure |
  /// production. The same video may be kept for more than one reason.
  use          String
  note         String   @default("")
  addedAt      DateTime @default(now())
  collection   ReferenceCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, videoId, use])
  @@index([collectionId])
}

model Folder {
  id              Int              @id @default(autoincrement())
  name            String
  workspaceId     Int
  createdAt       DateTime         @default(now())
  videos          FolderVideo[]
  ideaGenerations IdeaGeneration[]
  workspace       ChannelWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model FolderVideo {
  folderId Int
  videoId  String
  addedAt  DateTime @default(now())
  folder   Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  video    Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([folderId, videoId])
}

model Panel {
  id              Int              @id @default(autoincrement())
  name            String
  keyword         String
  workspaceId     Int
  filters         String // JSON blob of filter settings
  results         String           @default("[]") // JSON blob of video results
  createdAt       DateTime         @default(now())
  lastRefreshed   DateTime?
  ideaGenerations IdeaGeneration[]
  workspace       ChannelWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([workspaceId])
}

model IdeaGeneration {
  id          Int              @id @default(autoincrement())
  panelId     Int?
  folderId    Int?
  workspaceId Int
  prompt      String
  result      String // JSON blob of generated ideas
  createdAt   DateTime         @default(now())
  panel       Panel?           @relation(fields: [panelId], references: [id], onDelete: SetNull)
  folder      Folder?          @relation(fields: [folderId], references: [id], onDelete: SetNull)
  workspace   ChannelWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([folderId])
  @@index([panelId])
  @@index([workspaceId])
}

model AiCache {
  id        Int      @id @default(autoincrement())
  inputHash String   @unique
  endpoint  String
  response  String
  createdAt DateTime @default(now())

  @@index([inputHash])
}

model NicheDiscovery {
  id            Int      @id @default(autoincrement())
  workspaceId   Int
  interests     String?
  skills        String?
  constraints   String?
  goals         String?
  contentType   String?
  niches        String?
  selectedNiche String?
  deepDive      String?
  strategy      String?
  contentPlan   String?
  completedStep Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace ChannelWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([workspaceId])
}
