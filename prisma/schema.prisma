generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Video {
  id           String        @id // YouTube video ID
  title        String
  channelId    String
  channelName  String
  views        Int
  likes        Int
  comments     Int
  duration     String
  publishedAt  DateTime
  thumbnailUrl String
  description  String        @default("")
  transcript   String?
  outlierScore Float?
  viewsPerHour Float?
  savedAt      DateTime      @default(now())
  folders      FolderVideo[]

  @@index([channelId])
}

model VideoAnalysis {
  id             Int      @id @default(autoincrement())
  videoIds       String
  analysisResult String
  inspirations   String
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model Channel {
  id           String   @id // YouTube channel ID
  name         String
  subscribers  Int
  totalViews   BigInt
  videoCount   Int
  averageViews Float?
  lastFetched  DateTime

  @@index([lastFetched])
}

model Folder {
  id              Int              @id @default(autoincrement())
  name            String
  createdAt       DateTime         @default(now())
  videos          FolderVideo[]
  ideaGenerations IdeaGeneration[]
}

model FolderVideo {
  folderId Int
  videoId  String
  addedAt  DateTime @default(now())
  folder   Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  video    Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([folderId, videoId])
}

model Panel {
  id              Int              @id @default(autoincrement())
  name            String
  keyword         String
  filters         String // JSON blob of filter settings
  createdAt       DateTime         @default(now())
  lastRefreshed   DateTime?
  ideaGenerations IdeaGeneration[]

  @@index([createdAt])
}

model IdeaGeneration {
  id        Int      @id @default(autoincrement())
  panelId   Int?
  folderId  Int?
  prompt    String
  result    String // JSON blob of generated ideas
  createdAt DateTime @default(now())
  panel     Panel?   @relation(fields: [panelId], references: [id], onDelete: SetNull)
  folder    Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([folderId])
  @@index([panelId])
}

model AiCache {
  id        Int      @id @default(autoincrement())
  inputHash String   @unique
  endpoint  String
  response  String
  createdAt DateTime @default(now())

  @@index([inputHash])
}

model NicheDiscovery {
  id            Int      @id @default(autoincrement())
  interests     String?
  skills        String?
  constraints   String?
  goals         String?
  contentType   String?
  niches        String?
  selectedNiche String?
  deepDive      String?
  strategy      String?
  contentPlan   String?
  completedStep Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([createdAt])
}
